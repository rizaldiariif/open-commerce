# App
SITE_URL=http://localhost:3000
STORE_NAME=Muse Commerce
SUPPORT_EMAIL=support@example.com
SETUP_TOKEN=replace-with-one-time-superadmin-bootstrap-token

# Convex
# Generated when linking/running Convex locally.
CONVEX_DEPLOYMENT=dev:replace-me
VITE_CONVEX_URL=https://replace-me.convex.cloud

# Convex Auth
# Store production values in Convex/Vercel environment settings.
JWT_PRIVATE_KEY=replace-with-convex-auth-private-key
JWKS=replace-with-convex-auth-jwks-json

# Xendit
XENDIT_SECRET_KEY=xnd_development_replace_me
XENDIT_PUBLIC_KEY=xnd_public_development_replace_me
XENDIT_WEBHOOK_TOKEN=replace-with-xendit-webhook-token
XENDIT_CALLBACK_URL=http://localhost:3000/api/xendit/webhook

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Muse Commerce <orders@example.com>
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Commerce defaults
PENDING_PAYMENT_EXPIRY_MINUTES=60
CURRENCY=IDR
